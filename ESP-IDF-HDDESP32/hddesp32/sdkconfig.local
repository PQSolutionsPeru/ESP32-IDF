# STACKS PRINCIPALES - CONSERVADORES PERO SEGUROS
CONFIG_MQTT_TASK_STACK_SIZE=8192
CONFIG_ESP_MAIN_TASK_STACK_SIZE=10240
CONFIG_HTTPD_TASK_STACK_SIZE=6144
CONFIG_TCPIP_TASK_STACK_SIZE=8192
CONFIG_ESP_TIMER_TASK_STACK_SIZE=4096
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=4096

# BUFFERS MQTT OPTIMIZADOS
CONFIG_MQTT_BUFFER_SIZE=1536

# BUFFERS WIFI ESTABLES
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_RX_BA_WIN=6
CONFIG_ESP_WIFI_TX_BA_WIN=6

# BUFFERS TCP/IP OPTIMIZADOS
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=6144
CONFIG_LWIP_TCP_WND_DEFAULT=6144
CONFIG_LWIP_TCP_RECVMBOX_SIZE=16
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=32

# LOGGING CON TIMESTAMP REAL
CONFIG_LOG_TIMESTAMP_SOURCE_RTOS=y

# WATCHDOG MAS TOLERANTE
CONFIG_ESP_INT_WDT_TIMEOUT_MS=5000
CONFIG_ESP_TASK_WDT_TIMEOUT_S=40

# RECOVERY AUTOMATICO
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y

CONFIG_NVS_ENCRYPTION=n