# Configuración de particiones
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# Configuración del servidor HTTP
CONFIG_HTTPD_TASK_STACK_SIZE=8192

# Configuración optimizada de stacks
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
# ******** CORRECCIÓN CRÍTICA PARA STACK OVERFLOW ********
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
# ******************************************************
CONFIG_ESP_TIMER_TASK_STACK_SIZE=4096
CONFIG_LWIP_TCPIP_TASK_STACK_SIZE=4096

# MQTT optimizado
# ******** CORRECCIÓN CRÍTICA PARA STACK OVERFLOW ********
CONFIG_MQTT_TASK_STACK_SIZE=6144
# ******************************************************
CONFIG_MQTT_BUFFER_SIZE=1024

# Para futuros GPIO interrupts (relays)
CONFIG_GPIO_ISR_HANDLER_STACK_SIZE=2048

# Optimizaciones de sistema
CONFIG_FREERTOS_USE_TICKLESS_IDLE=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

# Optimización de memoria
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_DISABLE=n

# HTTP Server optimizado
CONFIG_HTTPD_TASK_STACK_SIZE=6144

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"