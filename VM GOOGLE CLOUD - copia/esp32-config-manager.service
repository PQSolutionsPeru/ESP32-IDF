[Unit]
Description=ESP32 Configuration Manager Service
Documentation=https://github.com/tuorganizacion/vm-monitor
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Environment=GOOGLE_APPLICATION_CREDENTIALS=/home/pqsolutionsperu/vm-service-key.json
Type=simple
User=pqsolutionsperu
Group=pqsolutionsperu
WorkingDirectory=/home/pqsolutionsperu
ExecStart=/usr/bin/python3 /home/pqsolutionsperu/esp32_config_manager.py
Restart=always
RestartSec=30
TimeoutStartSec=90
TimeoutStopSec=90

# Límites de recursos
MemoryMax=512M
CPUQuota=50%
LimitNOFILE=65535

# Logs
StandardOutput=append:/var/log/esp32_config_manager.log
StandardError=append:/var/log/esp32_config_manager.error.log

# Configuración de seguridad
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
SystemCallArchitectures=native

# Variables de entorno
Environment=PYTHONUNBUFFERED=1
Environment=TZ=America/Lima

[Install]
WantedBy=multi-user.target